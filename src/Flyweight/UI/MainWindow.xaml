<Window x:Class="Flyweight.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flyweight"
        Width="480"
        SizeToContent="Height"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="Window_DragOver"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar" />
  </Window.TaskbarItemInfo>

  <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg}" Focusable="False"
                SizeChanged="Layout_SizeChanged">
    <Grid x:Name="Page" Margin="16,16,16,10" MaxWidth="1240">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="SideColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <!-- Advanced options move here when the window is wide enough -->
      <Decorator x:Name="SideSlot" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Visibility="Collapsed" />

    <StackPanel x:Name="MainColumn" VerticalAlignment="Top" SizeChanged="Layout_SizeChanged">

      <!-- ffmpeg isn't installed -->
      <Border x:Name="MissingToolsBanner" Visibility="Collapsed" Margin="0,0,0,12" Padding="12,10" CornerRadius="8"
              Background="{DynamicResource DangerSoft}">
        <DockPanel>
          <Button x:Name="InstallToolsButton" DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Padding="12,5"
                  VerticalAlignment="Center" Margin="12,0,0,0" Click="InstallToolsButton_Click">Install it</Button>
          <StackPanel>
            <TextBlock Text="ffmpeg is needed but isn't installed" FontWeight="SemiBold" />
            <TextBlock x:Name="MissingToolsDetail" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                       Text="It's the free engine that does the compressing. Installing takes about a minute." />
          </StackPanel>
        </DockPanel>
      </Border>

      <StackPanel x:Name="MainControls">

        <!-- Drop zone -->
        <Button x:Name="DropZone" Style="{DynamicResource DropZoneButton}" Height="132" Click="DropZone_Click"
                AutomationProperties.Name="Choose videos to compress">
          <StackPanel HorizontalAlignment="Center">
            <Path Data="M12,3 V15 M7,10.5 L12,15.5 L17,10.5 M4,20 H20" Stroke="{DynamicResource Accent}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Center" Margin="0,0,0,8" Width="24" Height="24" />
            <TextBlock Text="Drop videos here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="or click to choose files" Style="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="DropHint" Visibility="Collapsed" Foreground="{DynamicResource Danger}" Margin="2,6,0,0"
                   Text="That doesn't look like a video, so nothing was added." />

        <!-- Levels -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <RadioButton x:Name="LevelLight" Grid.Column="0" GroupName="Level" Style="{DynamicResource LevelCard}" Checked="Level_Checked"
                       AutomationProperties.Name="Light: Full resolution">
            <StackPanel>
              <TextBlock Text="Light" FontWeight="SemiBold" />
              <TextBlock Text="Full resolution" Style="{DynamicResource Muted}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="LevelBalanced" Grid.Column="2" GroupName="Level" Style="{DynamicResource LevelCard}" Checked="Level_Checked"
                       AutomationProperties.Name="Balanced: Up to 1080p">
            <StackPanel>
              <TextBlock Text="Balanced" FontWeight="SemiBold" />
              <TextBlock Text="Up to 1080p" Style="{DynamicResource Muted}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="LevelMaximum" Grid.Column="4" GroupName="Level" Style="{DynamicResource LevelCard}" Checked="Level_Checked"
                       AutomationProperties.Name="Maximum: 720p, 30 fps">
            <StackPanel>
              <TextBlock Text="Maximum" FontWeight="SemiBold" />
              <TextBlock Text="720p, 30 fps" Style="{DynamicResource Muted}" />
            </StackPanel>
          </RadioButton>
        </Grid>

        <!-- Presets the user made. The negative margin lines their cards up with the row above. -->
        <UniformGrid x:Name="CustomCards" Columns="3" Margin="-4,0,-4,0" />

        <TextBlock x:Name="LevelSummary" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,8,2,0" />

        <DockPanel Margin="2,10,2,0">
          <Button x:Name="NewPresetButton" DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" FontSize="12" Margin="12,0,0,0"
                  Click="NewPresetButton_Click">+ New preset</Button>
          <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Visibility="Collapsed"
                  FontSize="12" Click="ResetButton_Click">Reset this level</Button>
          <Button x:Name="DeletePresetButton" DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Visibility="Collapsed"
                  FontSize="12" Click="DeletePresetButton_Click">Delete this preset</Button>
          <ToggleButton x:Name="AdvancedToggle" Style="{DynamicResource DisclosureToggle}" HorizontalAlignment="Left"
                        Checked="AdvancedToggle_Changed" Unchecked="AdvancedToggle_Changed">Advanced options</ToggleButton>
        </DockPanel>

        <!-- Advanced -->
        <Decorator x:Name="StackedSlot">
        <Border x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="14,12" CornerRadius="8"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <StackPanel Grid.IsSharedSizeScope="True">
          <Grid x:Name="PresetNameRow" Visibility="Collapsed" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabels" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource FieldLabel}" Text="Preset name" />
            <TextBox x:Name="PresetNameBox" Grid.Column="1" Height="28" MaxLength="40" AutomationProperties.Name="Preset name" TextChanged="PresetNameBox_TextChanged" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabels" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{DynamicResource FieldLabel}" Text="Format" />
            <ComboBox x:Name="CodecBox" Grid.Row="0" Grid.Column="1" AutomationProperties.Name="Format" SelectionChanged="CodecBox_SelectionChanged" />

            <TextBlock Grid.Row="2" Style="{DynamicResource FieldLabel}" Text="Encode with" />
            <ComboBox x:Name="EncoderBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Encode with" SelectionChanged="Advanced_Changed" />

            <TextBlock Grid.Row="4" Style="{DynamicResource FieldLabel}" Text="Quality" />
            <DockPanel Grid.Row="4" Grid.Column="1">
              <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Style="{DynamicResource Muted}" Width="22" TextAlignment="Right"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
              <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Muted}" Text="Smaller" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock DockPanel.Dock="Right" Style="{DynamicResource Muted}" Text="Better" VerticalAlignment="Center" Margin="8,0,0,0" />
              <Slider x:Name="QualitySlider" AutomationProperties.Name="Quality" IsDirectionReversed="True" Minimum="10" Maximum="51" SmallChange="1" LargeChange="3"
                      IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="QualitySlider_ValueChanged" />
            </DockPanel>

            <TextBlock Grid.Row="6" Style="{DynamicResource FieldLabel}" Text="Max resolution" />
            <ComboBox x:Name="ResolutionBox" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Max resolution" SelectionChanged="Advanced_Changed" />

            <TextBlock Grid.Row="8" Style="{DynamicResource FieldLabel}" Text="Frame rate" />
            <ComboBox x:Name="FrameRateBox" Grid.Row="8" Grid.Column="1" AutomationProperties.Name="Frame rate" SelectionChanged="Advanced_Changed" />

            <TextBlock Grid.Row="10" Style="{DynamicResource FieldLabel}" Text="Audio" />
            <ComboBox x:Name="AudioBox" Grid.Row="10" Grid.Column="1" AutomationProperties.Name="Audio" SelectionChanged="Advanced_Changed" />

            <TextBlock Grid.Row="12" Style="{DynamicResource FieldLabel}" Text="Fit under" />
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="TargetSizeBox" Width="64" Height="28" AutomationProperties.Name="Fit under, in megabytes" TextChanged="Advanced_TextChanged" />
              <TextBlock Style="{DynamicResource Muted}" Text="MB (leave empty for no limit)" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="14" Style="{DynamicResource FieldLabel}" Text="Extra ffmpeg options" />
            <TextBox x:Name="ExtraArgsBox" Grid.Row="14" Grid.Column="1" Height="28" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Extra ffmpeg options" TextChanged="Advanced_TextChanged" />

            <TextBlock Grid.Row="16" Style="{DynamicResource FieldLabel}" Text="Save to" />
            <DockPanel Grid.Row="16" Grid.Column="1">
              <Button x:Name="OutputFolderChange" DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Margin="10,0,0,0" Click="OutputFolderChange_Click">Change…</Button>
              <Button x:Name="OutputFolderClear" DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Margin="10,0,0,0" Click="OutputFolderClear_Click">Clear</Button>
              <TextBlock x:Name="OutputFolderText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
          </Grid>
          </StackPanel>
        </Border>
        </Decorator>
      </StackPanel>

      <!-- Queue -->
      <StackPanel x:Name="QueueArea" Visibility="Collapsed">
        <ScrollViewer x:Name="QueueScroller" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,12,0,0">
          <ItemsControl x:Name="QueueList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="11,8" Margin="0,0,0,6" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}" />
                      <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,1,0,0" />
                      <ProgressBar Value="{Binding Percent, Mode=OneWay}" Margin="0,6,0,2"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                      <Button Style="{DynamicResource LinkButton}" Content="Show in folder" FontSize="12" Click="ShowFile_Click"
                              Visibility="{Binding CanShowFile, Converter={StaticResource BoolToVisibility}}" />
                      <Button Style="{DynamicResource LinkButton}" Content="Details" FontSize="12" Click="Details_Click"
                              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                      <Button Style="{DynamicResource IconButton}" ToolTip="Cancel" AutomationProperties.Name="Cancel" Click="Cancel_Click"
                              Margin="4,0,-4,0" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Danger}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="ClosingNote" Style="{DynamicResource Muted}" Visibility="Collapsed" Margin="2,0,0,4" />
      </StackPanel>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
